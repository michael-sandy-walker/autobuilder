<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- LOG LEVELS -->
    <property name="LOG_LEVEL" value="INFO"/>
    <property name="FILE_LOG_LEVEL" value="DEBUG"/>
    <property name="ROOT_PATH" value="${FILE_BASE_PATH:-/data/firestarter}"/>

    <!-- Captures the JVM startup time so each run gets its own log file. -->
    <timestamp key="startTime" datePattern="yyyy-MM-dd_HH-mm-ss"/>

    <!-- PATTERN -->
    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- CONSOLE APPENDER -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- FILE APPENDER — per-run file, size-based rollover within a run, bounded retention across runs. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${ROOT_PATH}/logs/autobuilder-${startTime}.log</file>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${ROOT_PATH}/logs/autobuilder-${startTime}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- T5-H: BEHAVIOUR NDJSON APPENDER — one JSON object per line, no console output, per-run file. -->
    <appender name="BEHAVIOUR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${ROOT_PATH}/logs/behaviour-${startTime}.ndjson</file>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${ROOT_PATH}/logs/behaviour-${startTime}.%d{yyyy-MM-dd}.%i.ndjson.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ROOT LOGGER -->
    <root level="${LOG_LEVEL}">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- PACKAGE-SPECIFIC LOGGING -->
    <logger name="com.walpro.autobuilder" level="INFO"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate.SQL" level="OFF"/>

    <!-- T5-H: behaviour trace — only the dedicated NDJSON appender; no console, no main log -->
    <logger name="autobuilder.behaviour" level="INFO" additivity="false">
        <appender-ref ref="BEHAVIOUR"/>
    </logger>

</configuration>
