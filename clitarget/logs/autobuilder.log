```java [src/main/java/com/example/cli/reader/CsvReader.java]
package com.example.cli.reader;

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;

public class CsvReader {

    private final List<String> header;
    private final List<List<String>> rows;

    public CsvReader(Path path) throws CsvReaderException {
        try {
            List<String> lines = Files.readAllLines(path);
            if (lines.isEmpty()) {
                this.header = List.of();
                this.rows = List.of();
                return;
            }

            this.header = splitLine(lines.get(0));
            this.rows = new ArrayList<>();
            for (int i = 1; i < lines.size(); i++) {
                this.rows.add(splitLine(lines.get(i)));
            }
        } catch (IOException e) {
            throw new CsvReaderException("Failed to read file: " + path, e);
        }
    }

    public List<String> header() {
        return header;
    }

    public List<List<String>> rows() {
        return rows;
    }

    private static List<String> splitLine(String line) {
        if (line == null || line.isEmpty()) {
            return List.of();
        }
        String[] parts = line.split(",", -1);
        List<String> result = new ArrayList<>(parts.length);
        for (String part : parts) {
            result.add(part);
        }
        return result;
    }
}
