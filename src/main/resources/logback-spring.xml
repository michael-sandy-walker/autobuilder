<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- LOG LEVELS -->
    <property name="LOG_LEVEL" value="INFO"/>
    <property name="FILE_LOG_LEVEL" value="DEBUG"/>
    <property name="ROOT_PATH" value="${FILE_BASE_PATH:-/data/firestarter}"/>

    <!-- PATTERN -->
    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- CONSOLE APPENDER -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- T5-AE: FILE APPENDER — stable live target. StartupLogRotator (registered via
         META-INF/spring.factories) renames the previous run's autobuilder.log to
         autobuilder-<itsOwnStartTime>.log before this JVM's logback initialises.
         Retention of archived files is handled by T5-Q's RetentionPolicy. -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${ROOT_PATH}/logs/autobuilder.log</file>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- T5-H + T5-AE: BEHAVIOUR NDJSON APPENDER — stable live target; same rotation scheme. -->
    <appender name="BEHAVIOUR" class="ch.qos.logback.core.FileAppender">
        <file>${ROOT_PATH}/logs/behaviour.ndjson</file>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!-- ROOT LOGGER -->
    <root level="${LOG_LEVEL}">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- PACKAGE-SPECIFIC LOGGING -->
    <logger name="com.walpro.autobuilder" level="INFO"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate.SQL" level="OFF"/>

    <!-- T5-H: behaviour trace — only the dedicated NDJSON appender; no console, no main log -->
    <logger name="autobuilder.behaviour" level="INFO" additivity="false">
        <appender-ref ref="BEHAVIOUR"/>
    </logger>

</configuration>
